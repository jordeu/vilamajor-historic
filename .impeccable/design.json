      "html": "<button class=\"ds-icon-button\" aria-label=\"Tancar panell\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 6 12 12M6 18 18 6\"/></svg></button>",
      "css": ".ds-icon-button{font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;min-height:44px;border:0;border-radius:var(--radius,8px);display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background-color .16s,color .16s;width:44px;height:44px;padding:0;background:transparent;color:var(--muted,#53647b)}.ds-icon-button:hover{background:var(--tint,#eaf0fb);color:var(--blue-hover,#17438f)}.ds-icon-button:active{background:#d9e4f8}.ds-icon-button:focus-visible{outline:3px solid var(--focus,#326de0);outline-offset:3px;}@media(prefers-reduced-motion:reduce){button,input{transition:none!important;animation:none!important}}",
