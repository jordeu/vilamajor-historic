      "name": "Acció principal",
      "kind": "button",
      "description": "Entrada única al viatge o exploració del lloc de la fita.",
      "html": "<button class=\"ds-primary\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m8 5 11 7-11 7V5Z\"/></svg>Viatge guiat</button>",
      "css": ".ds-primary{font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;min-height:44px;border:0;border-radius:var(--radius,8px);display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background-color .16s,color .16s;font-weight:600;padding:0 18px;background:var(--blue,#2257b8);color:var(--surface,#fff)}.ds-primary:hover{background:var(--blue-hover,#17438f)}.ds-primary:active{background:#123470}.ds-primary:focus-visible{outline:3px solid var(--focus,#326de0);outline-offset:3px;}.ds-primary:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){button,input{transition:none!important;animation:none!important}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Acció secundària",
      "kind": "button",
      "description": "Enquadrament general dins de la llista de llocs.",
      "html": "<button class=\"ds-secondary\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>Veure tot el territori</button>",
      "css": ".ds-secondary{font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;min-height:44px;border:0;border-radius:var(--radius,8px);display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background-color .16s,color .16s;padding:0 12px;width:100%;background:var(--tint,#eaf0fb);color:var(--blue-hover,#17438f)}.ds-secondary:hover{background:var(--tint,#eaf0fb);color:var(--blue-hover,#17438f)}.ds-secondary:active{background:#d9e4f8}.ds-secondary:focus-visible{outline:3px solid var(--focus,#326de0);outline-offset:3px;}@media(prefers-reduced-motion:reduce){button,input{transition:none!important;animation:none!important}}",
