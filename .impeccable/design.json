    {
      "name": "Cerca de llocs",
      "kind": "input",
      "description": "Cerca amb nom accessible, focus de grup i mida mòbil llegible.",
      "html": "<label class=\"ds-search\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input aria-label=\"Cercar un lloc\" type=\"search\" placeholder=\"Cerca un poble o una urbanització\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;border:1px solid #bccbde;border-radius:var(--radius,8px);padding:0 12px;background:#f8fafd;color:var(--muted,#53647b);min-height:46px}.ds-search svg{flex:none}.ds-search input{font:13px \"DM Sans\",sans-serif;color:var(--ink,#17283e);min-width:0;width:100%;padding:12px 0;border:0;outline:none;background:none;caret-color:var(--blue,#2257b8)}.ds-search input::placeholder{color:#60718a;opacity:1}.ds-search:focus-within{outline:3px solid var(--focus,#326de0);outline-offset:3px;outline-offset:2px}@media(max-width:640px){.ds-search input{font-size:16px}}@media(prefers-reduced-motion:reduce){button,input{transition:none!important;animation:none!important}}",
      "refersTo": "search-field"
    },
    {
      "name": "Navegació principal",
      "kind": "nav",
      "description": "Navegació blava amb selecció blanca i noms accessibles.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegació principal\"><button aria-expanded=\"true\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 11a9 9 0 1 1 2.6 7M3 4v7h7m2-5v6l4 2\"/></svg><span>Cronologia</span></button><button aria-expanded=\"false\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 21V9l8-6 8 6v12M2 21h20M9 21v-6h6v6M9 9h6M12 6v6\"/></svg><span>Patrimoni</span></button><button aria-expanded=\"false\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5c-3-2-7-2-10-1v15c3-1 7-1 10 1m0-15c3-2 7-2 10-1v15c-3-1-7-1-10 1V5Z\"/></svg><span>Fonts i dades</span></button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:6px;padding:12px;background:var(--navy,#173761)}.ds-nav button{font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;min-height:44px;border:0;border-radius:var(--radius,8px);display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background-color .16s,color .16s;padding:0 16px;color:#e1eafa;background:transparent}.ds-nav button[aria-expanded=true]{background:#fff;color:var(--navy,#173761)}.ds-nav button:hover{background:#2c4e7c;color:#fff}.ds-nav button:active{background:#d9e4f8;color:var(--navy,#173761)}.ds-nav button:focus-visible{outline:3px solid #c2d6ff;outline-offset:3px}@media(max-width:640px){.ds-nav button{width:44px;padding:0}.ds-nav span{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}}@media(prefers-reduced-motion:reduce){button,input{transition:none!important;animation:none!important}}",
      "refersTo": "navigation"
    },
